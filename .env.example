# Copy to .env and adjust. All backend settings use the TCP_ prefix.

# ── storage & database (live on the mounted /data volume) ─────────────
TCP_STORAGE_ROOT=/data/storage
TCP_DATABASE_URL=sqlite:////data/treecrown.db

# ── model catalog 
# Detector weights live outside the repo. Set this host path to the folder that
# contains the .pth files named in code/models.yaml. It is mounted read-only at
# /models inside the API container.
HOST_MODELS_DIR=./models
TCP_MODELS_DIR=/models
TCP_MODELS_MANIFEST=/code/models.yaml
TCP_DEFAULT_MODEL_KEY=urban_cambridge

# ── run mode 
# Compute runs in-process (.apply()); no Redis/Celery worker needed here.
TCP_CELERY_EAGER=false

# ── Airflow: full loop (configurable per host) 
# Our backend -> Airflow REST, to START a DAG run when the frontend hits
# /runs/analyze or /runs/finalize. Point this at wherever Airflow runs.
#   local Airflow on the same machine:  http://host.docker.internal:8080
#   remote Airflow:                     http://<airflow-host>:8080
TCP_AIRFLOW_BASE_URL=http://host.docker.internal:8080
TCP_ANALYZE_DAG_ID=drone_analyze
TCP_FINALIZE_DAG_ID=drone_finalize
# Airflow REST auth (basic-auth admin from `airflow standalone`, or a token):
TCP_AIRFLOW_USERNAME=admin
TCP_AIRFLOW_PASSWORD=
# TCP_AIRFLOW_AUTH_TOKEN=

# ── optional auth on our endpoints ────────────────────────────────────
# Protect the browser API:
# TCP_API_KEY=change-me
# Protect the compute callback the DAG calls (then set DRONE_SERVICE_TOKEN
# on the Airflow worker to the same value):
# TCP_COMPUTE_TOKEN=change-me

# ── Google sign-in (GIS client-side flow, audit-only) ──────────────────
# When true, human endpoints require the X-User-Email header set by the
# frontend after Google sign-in (used for per-user audit + ownership; the
# token is NOT verified here — safe only behind a gateway / internal network).
# TCP_AUTH_ENABLED=true
# The PUBLIC Google client id actually lives in the FRONTEND (frontend/config.js).
# This backend value is FYI / only needed if you later add server-side token
# verification (see docs/OAUTH_GIS_INTEGRATION_PLAN.md §4b).
# TCP_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ── logging (side-channel; see docs/ERROR_LOGGING_PLAN.md) ─────────────
# Central logs + errors.jsonl live in TCP_LOG_DIR, OUTSIDE storage_root/projects
# so they survive retention prune/delete. JSON in prod, text in dev.
# TCP_LOG_LEVEL=INFO
# TCP_LOG_DIR=/data/logs
# TCP_LOG_JSON=true
# TCP_LOG_MAX_BYTES=10000000
# TCP_LOG_BACKUP_COUNT=5

# uploads 
TCP_MAX_UPLOAD_MB=8192

# per-project orthomosaic library limits
# Total stored orthomosaic bytes per project, in GB. 0 disables the check.
# Exceeding it -> 413 PROJECT_QUOTA_EXCEEDED.
TCP_PROJECT_QUOTA_GB=5
# Maximum number of orthomosaics per project. 0 disables the check.
TCP_MAX_ORTHOS_PER_PROJECT=10

# ── Orthomosaic transfer budget ───────────────────────────────────────────
# Wall-clock ceiling on ONE orthomosaic transfer — browser upload or Google
# Drive download — measured from the first byte. It protects the server: a
# stalled transfer otherwise holds a worker and the project's UPLOADING claim
# for as long as the far end keeps the socket open.
#
# Enforcement differs by path, because the code differs:
#   * upload   - checked between 1 MiB chunks, aborts and deletes the partial file
#   * Drive    - gdown is one blocking call, so it runs in a child process which
#                is sent SIGKILL at the deadline; the scratch dir is then wiped
#
# Either way nothing partial is kept, and the caller gets 408 TRANSFER_TIMEOUT.
# Set to 0 to disable the ceiling.
TCP_ORTHO_TRANSFER_TIMEOUT_MIN=45

# ── build-time: torch wheel index (CPU default; cu128 for GPU) ─────────
# TORCH_INDEX=https://download.pytorch.org/whl/cu118


# ═══════════════════════════════════════════════════════════════════════════
# Settings that existed in the code but were never documented here.
#
# Every one of these was already readable from the environment — the template
# just never mentioned them, so a new deployment inherited whatever the default
# happened to be and nobody knew there was a choice. The six connection values
# in the first two groups are the ones that bite behind a reverse proxy.
# ═══════════════════════════════════════════════════════════════════════════

# ── Reverse-proxy / public addressing ─────────────────────────────────────
# The externally visible base URL of this service, as a browser sees it —
# scheme, host, and path prefix included. Used to build absolute asset URLs in
# the STAC item (services/stac.py); when it is empty those URLs come out
# relative to the container, which is wrong the moment anything outside the
# container reads them.
#
# Set this to whatever nginx exposes, with NO trailing slash:
TCP_PUBLIC_BASE_URL=

# Browser origins allowed to call this API. Comma-separated, or * for any.
# Leave as * only while the UI and API share one origin behind the same proxy
# (in that case the browser makes no cross-origin request and this is unused).
# If the UI is served from a different host or port, name it explicitly:
TCP_CORS_ORIGINS=*

#  FileBrowser (output file browsing) 
# base_url is what THIS BACKEND calls (container-to-container is fine);
# public_url is what the USER'S BROWSER is given, so it must be the address
# nginx exposes. They differ whenever the service is proxied — that difference
# is the whole reason there are two settings.
TCP_FILEBROWSER_BASE_URL=
TCP_FILEBROWSER_PUBLIC_URL=
TCP_FILEBROWSER_USERNAME=admin
TCP_FILEBROWSER_PASSWORD=

#  Task queue 
# Celery broker + result backend. Note the default says "localhost", which
# inside a container means the container itself — set it explicitly if Redis
# runs as a separate service. Unused while TCP_CELERY_EAGER=1.
TCP_REDIS_URL=redis://localhost:6379/0

#  Airflow DAG ids 
# The unified DAG used by the drone_api callback (the other two ids are above).
TCP_DRONE_DAG_ID=drone_pipeline

# Retention (NOT active)
TCP_CLEANUP_ENABLED=false
TCP_RETENTION_DAYS=30
TCP_RETAIN_CONSENT_ALL=true
TCP_CLEANUP_HOUR=3
TCP_CLEANUP_MINUTE=0


# Host folder holding the detector .pth weights. REQUIRED — compose refuses to
# start without it. Already set once above, under "model catalog"; it is a
# compose-level variable, so it is cross-referenced rather than repeated. A
# second definition here would override that one, and an empty override is
# exactly what stops a fresh deployment from starting.

# Host ports. Change these rather than editing docker-compose.yml.
TCP_API_PORT=8123
TCP_FRONTEND_PORT=8200


# Uncomment only to pin a specific published tag.
# IMAGE_API=uavforaliens/treecrown-workstation:cu128
# IMAGE_FRONTEND=uavforaliens/treecrown-frontend:latest
TORCH_INDEX=https://download.pytorch.org/whl/cpu
HF_HUB_OFFLINE=1
