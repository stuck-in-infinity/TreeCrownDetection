# Copy to .env and adjust. All backend settings use the TCP_ prefix and map 1:1
# to fields in code/app/core/settings.py.
#
# Layout: the first half is what a deployment sets and the running code reads.
# The second half is optional overrides (commented out, the default applies)
# and settings nothing reads today. Keep new variables in the right half.

# ════════════════════════════════════════════════════════════════════════
#  IN USE
# ════════════════════════════════════════════════════════════════════════

#  Container / compose
# One container serves both the API and the web UI (the API serves frontend/
# at "/") on this one host port. Users open it, and Airflow calls back on it:
# the Airflow worker's DRONE_API_BASE is http://<host>:<DRONE_API_PORT>.
# Change it here rather than editing the compose files.
DRONE_API_PORT=8200

# Image. Published tags: v1 (CPU torch) and v1-cu128 (GPU torch). The compose
# files default to v1-cu128; uncomment only to pin a different tag, e.g. v1 on
# a CPU-only host.
# IMAGE_API=uavforaliens/treecrown-workstation:v1-cu128

# Build-time: torch wheel index for `docker compose build` / publish.sh.
#   CPU  (tag v1):       https://download.pytorch.org/whl/cpu
#   GPU  (tag v1-cu128): https://download.pytorch.org/whl/cu128
TORCH_INDEX=https://download.pytorch.org/whl/cpu

# DINOv2 is already cached under /data/hf-cache; skip the Hugging Face network
# check on every run. Clear it once to let a fresh install download the model.
HF_HUB_OFFLINE=1

#  Model catalog
# Detector weights live outside the repo. Set this host path to the folder that
# contains the .pth files named in code/models.yaml. It is mounted read-only at
# /models inside the container. REQUIRED: compose refuses to start without it.
HOST_MODELS_DIR=./models
TCP_MODELS_DIR=/models
TCP_MODELS_MANIFEST=/code/models.yaml
TCP_DEFAULT_MODEL_KEY=urban_cambridge

#  Storage & database (live on the mounted /data volume)
# For Postgres, leave TCP_DATABASE_URL here and set the TCP_DB_* values in the
# optional section below.
TCP_STORAGE_ROOT=/data/storage
TCP_DATABASE_URL=sqlite:////data/treecrown.db

#  Public addressing
# The address users open, with NO trailing slash, e.g. http://<host-ip>:8200.
# STAC asset/link hrefs are made absolute with it; blank emits relative hrefs.
TCP_PUBLIC_BASE_URL=

# Browser origins allowed to call this API. Comma-separated, or * for any.
# The UI is served from the API's own origin, so the browser makes no
# cross-origin request and * is harmless. Name origins explicitly only if a
# UI hosted elsewhere calls this API.
TCP_CORS_ORIGINS=*

#  Uploads and per-project orthomosaic limits
TCP_MAX_UPLOAD_MB=8192
# Total stored orthomosaic bytes per project, in GB. 0 disables the check.
# Exceeding it : 413 PROJECT_QUOTA_EXCEEDED.
TCP_PROJECT_QUOTA_GB=5
# Maximum number of orthomosaics per project. 0 disables the check.
TCP_MAX_ORTHOS_PER_PROJECT=10

# Wall-clock ceiling on ONE orthomosaic transfer, browser upload or Google
# Drive download, measured from the first byte. It protects the server: a
# stalled transfer otherwise holds a worker and the project's UPLOADING claim
# for as long as the far end keeps the socket open.
#
# Enforcement differs by path, because the code differs:
#   * upload   - checked between 1 MiB chunks, aborts and deletes the partial file
#   * Drive    - gdown is one blocking call, so it runs in a child process which
#                is sent SIGKILL at the deadline; the scratch dir is then wiped
#
# Either way nothing partial is kept, and the caller gets 408 TRANSFER_TIMEOUT.
# Set to 0 to disable the ceiling.
TCP_ORTHO_TRANSFER_TIMEOUT_MIN=45

#  Airflow (full loop, configurable per host)
# Our backend -> Airflow REST, to START a DAG run when the frontend hits
# /runs/analyze or /runs/finalize. Point this at wherever Airflow runs.
#   local Airflow on the same machine:  http://host.docker.internal:8080
#   remote Airflow:                     http://<airflow-host>:8080
# Blank (or commented out) runs the compute in-process instead, no Airflow.
TCP_AIRFLOW_BASE_URL=http://host.docker.internal:8080
TCP_ANALYZE_DAG_ID=drone_analyze
TCP_FINALIZE_DAG_ID=drone_finalize
# The unified DAG used by the drone_api callback.
TCP_DRONE_DAG_ID=drone_pipeline
# Airflow REST auth (basic-auth admin from `airflow standalone`, or a token
# below under the optional section):
TCP_AIRFLOW_USERNAME=admin
TCP_AIRFLOW_PASSWORD=

#  Web UI config
# The page gets these through /config.js, which the API generates from .env on
# every load; there is no frontend/config.js to edit. Restart the container
# after changing them.
#
# PUBLIC Google OAuth client id (Web application) for sign-in. Not a secret.
# Add the UI origin (e.g. http://<host-ip>:8200) under "Authorized JavaScript
# origins" in Google Cloud Console. Blank = sign-in not configured.
TCP_GOOGLE_CLIENT_ID=

#  FileBrowser (output file browsing)
# base_url is what THIS BACKEND calls (container-to-container is fine).
# public_url is what the USER'S BROWSER is given, so it must be reachable from
# there. They differ if the service is proxied. Blank base_url disables it.
TCP_FILEBROWSER_BASE_URL=
TCP_FILEBROWSER_PUBLIC_URL=
TCP_FILEBROWSER_USERNAME=admin
TCP_FILEBROWSER_PASSWORD=


# ════════════════════════════════════════════════════════════════════════
#  OPTIONAL — defaults apply unless uncommented
# ════════════════════════════════════════════════════════════════════════

#  Postgres
# Leave TCP_DATABASE_URL at its default above and set these instead; the
# backend composes the URL and percent-encodes the password, so any password
# works. The first three names match the other production backend
# (core-stack-backend's DB_NAME / DB_USER / DB_PASSWORD).
#
# TCP_DB_PASSWORD is also what docker-compose hands the `db` service, and it
# is REQUIRED once you run that service. The service sits behind a compose
# profile, so it only starts with `docker compose --profile postgres up -d`.
# TCP_DB_NAME=treecrown
# TCP_DB_USER=treecrown
# TCP_DB_PASSWORD=change-me
# TCP_DB_HOST=db          # the compose service; 127.0.0.1 would be the api container
# TCP_DB_PORT=5432

# Come up on SQLite when Postgres is unreachable at startup, instead of
# crash-looping. The two databases hold different data, so writes made during a
# fallback boot are invisible to Postgres afterwards, with no merge.
# GET /readyz says which backend is live. Set false once Postgres is trusted.
# TCP_DB_FALLBACK_SQLITE=true
# TCP_DB_FALLBACK_URL=sqlite:////data/treecrown.db
# TCP_DB_CONNECT_TIMEOUT_S=60

#  Run time limits
# A run gets its own process, which stops itself when its time is up: first by
# raising inside the run, then by killing its own interpreter after
# TCP_RUN_KILL_GRACE_S if it is stuck in a C call. It self-times rather than
# being watched by the API, so an API restart mid-run cannot leave it running
# forever. The result is recorded as a RUN_TIMEOUT failure.
#
# Only analyze and finalize are covered; labelling and project creation are
# short request-handled operations and are left alone.
#
# WARNING on 10: detection + DINOv2 on a large survey can run well past ten
# minutes, and this cannot tell wedged from busy, so it will kill healthy runs
# on a big orthomosaic. Time a real run on this hardware first. 0, or
# TCP_RUN_TIMEOUT_ENABLED=false, means no limit.
# TCP_RUN_TIMEOUT_ENABLED=true
# TCP_ANALYZE_TIMEOUT_MIN=10
# TCP_FINALIZE_TIMEOUT_MIN=10
# TCP_RUN_KILL_GRACE_S=30

#  Pipeline behaviour
# How many sample crowns per cluster get a thumbnail during analysis, for the
# review screen. 0 renders none and converts every crown on demand instead.
# TCP_THUMBS_PER_CLUSTER=5

# At start-up, mark runs that a restart killed as FAILED so they can be re-run.
# Runs handed to Airflow are left alone. Turn off only to debug a stuck project.
# TCP_STARTUP_RECOVERY_ENABLED=true

#  Web UI
# Folder the API serves at "/". Blank = /frontend in the image (bind-mounted
# from ./frontend by compose), or the repo's frontend/ when run from a checkout.
# TCP_FRONTEND_DIR=

# API origin the page calls (window.API_BASE). Blank = same origin, right
# whenever this container serves the page. Set only for a UI hosted elsewhere.
# TCP_FRONTEND_API_BASE=

#  Auth on our endpoints
# Protect the browser API:
# TCP_API_KEY=change-me
# Protect the compute callback the DAG calls (then set DRONE_SERVICE_TOKEN
# on the Airflow worker to the same value).
# Required, not optional, once real users own projects: Airflow sends no
# X-User-Email, so without this token its callbacks 403 on the ownership check.
# TCP_COMPUTE_TOKEN=change-me

# Accept callbacks that carry no credential. Our Airflow is administered by
# another team, so DRONE_SERVICE_TOKEN cannot be set on their worker and its
# callbacks arrive with neither header, which is the 403 above. With this true,
# a request on a callback path that names no user is accepted as the
# orchestrator. That is unauthenticated access to those routes, so only set it
# where the API is unreachable from outside. Remove once Airflow sends a JWT.
# TCP_TRUST_UNAUTHENTICATED_CALLBACKS=true

# Google sign-in. When true, computational endpoints require the X-User-Email
# header set by the frontend after Google sign-in (TCP_GOOGLE_CLIENT_ID above).
# TCP_AUTH_ENABLED=true

# Airflow REST bearer token, as an alternative to username/password above.
# TCP_AIRFLOW_AUTH_TOKEN=

#  Logging (side-channel)
# Central logs + errors.jsonl live in TCP_LOG_DIR, OUTSIDE storage_root/projects
# TCP_LOG_LEVEL=INFO
# TCP_LOG_DIR=/data/logs
# TCP_LOG_JSON=true
# TCP_LOG_MAX_BYTES=10000000
# TCP_LOG_BACKUP_COUNT=5


# ════════════════════════════════════════════════════════════════════════
#  NOT IN USE — read by settings but inert in this deployment
# ════════════════════════════════════════════════════════════════════════

# Celery. Every dispatch path runs its task in-process with .apply(), so no
# broker, worker or Redis is involved and neither value has any effect.
# Note "localhost" inside a container means the container itself.
TCP_CELERY_EAGER=false
TCP_REDIS_URL=redis://localhost:6379/0

# Retention. The consent-aware pass is scripts/run_retention.py under system
# cron, which reads RETENTION_DAYS and RETAIN_CONSENT_ALL. The CLEANUP_* values
# drive the old Celery beat job, which deletes without checking consent; keep
# it disabled.
TCP_CLEANUP_ENABLED=false
TCP_RETENTION_DAYS=30
TCP_RETAIN_CONSENT_ALL=true
TCP_CLEANUP_HOUR=3
TCP_CLEANUP_MINUTE=0
