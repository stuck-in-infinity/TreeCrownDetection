# Copy to .env. TCP_* settings map to code/app/core/settings.py.

# Container
DRONE_API_PORT=8200
TORCH_INDEX=https://download.pytorch.org/whl/cpu
HF_HUB_OFFLINE=1

# Models (HOST_MODELS_DIR is required)
HOST_MODELS_DIR=./models
TCP_MODELS_DIR=/models
TCP_MODELS_MANIFEST=/code/models.yaml
TCP_DEFAULT_MODEL_KEY=urban_cambridge

# Storage and database
TCP_STORAGE_ROOT=/data/storage
TCP_DATABASE_URL=sqlite:////data/treecrown.db

# Public address, no trailing slash
TCP_PUBLIC_BASE_URL=
TCP_CORS_ORIGINS=*

# Upload limits (0 disables)
TCP_MAX_UPLOAD_MB=8192
TCP_PROJECT_QUOTA_GB=5
TCP_MAX_ORTHOS_PER_PROJECT=10
TCP_ORTHO_TRANSFER_TIMEOUT_MIN=45

# Airflow (blank base URL runs compute in-process)
TCP_AIRFLOW_BASE_URL=http://host.docker.internal:8080
TCP_ANALYZE_DAG_ID=drone_analyze
TCP_FINALIZE_DAG_ID=drone_finalize
TCP_DRONE_DAG_ID=drone_pipeline
TCP_AIRFLOW_USERNAME=admin
TCP_AIRFLOW_PASSWORD=

# Web UI: public Google client id, sent to the page
TCP_GOOGLE_CLIENT_ID=

# FileBrowser (blank base URL disables)
TCP_FILEBROWSER_BASE_URL=
TCP_FILEBROWSER_PUBLIC_URL=
TCP_FILEBROWSER_USERNAME=admin
TCP_FILEBROWSER_PASSWORD=

# Not used: Celery and old retention job
TCP_CELERY_EAGER=false
TCP_REDIS_URL=redis://localhost:6379/0
TCP_CLEANUP_ENABLED=false
TCP_RETENTION_DAYS=30
TCP_RETAIN_CONSENT_ALL=true
TCP_CLEANUP_HOUR=3
TCP_CLEANUP_MINUTE=0

# Optional, add to set (default in brackets):
#   IMAGE_API                        image tag [uavforaliens/treecrown-workstation:v1-cu128]
#   TCP_DB_NAME, TCP_DB_USER         Postgres, used when TCP_DATABASE_URL is the default
#   TCP_DB_PASSWORD                  Postgres password, also used by the db service
#   TCP_DB_HOST, TCP_DB_PORT         [db, 5432]
#   TCP_DB_FALLBACK_SQLITE           use SQLite if Postgres is down [true]
#   TCP_DB_FALLBACK_URL              [sqlite:////data/treecrown.db]
#   TCP_DB_CONNECT_TIMEOUT_S         [60]
#   TCP_RUN_TIMEOUT_ENABLED          [true]
#   TCP_ANALYZE_TIMEOUT_MIN          minutes, 0 for no limit [10]
#   TCP_FINALIZE_TIMEOUT_MIN         minutes, 0 for no limit [10]
#   TCP_RUN_KILL_GRACE_S             [30]
#   TCP_THUMBS_PER_CLUSTER           [5]
#   TCP_STARTUP_RECOVERY_ENABLED     [true]
#   TCP_FRONTEND_DIR                 UI folder [/frontend]
#   TCP_FRONTEND_API_BASE            API URL for a UI hosted elsewhere [same origin]
#   TCP_API_KEY                      require X-API-Key on the API
#   TCP_COMPUTE_TOKEN                require X-Service-Token on callbacks
#   TCP_TRUST_UNAUTHENTICATED_CALLBACKS  only on a private network [false]
#   TCP_AUTH_ENABLED                 require Google sign-in [false]
#   TCP_AIRFLOW_AUTH_TOKEN           instead of Airflow username/password
#   TCP_LOG_LEVEL, TCP_LOG_DIR       [INFO, /data/logs]
#   TCP_LOG_JSON                     [false]
#   TCP_LOG_MAX_BYTES, TCP_LOG_BACKUP_COUNT  [10000000, 5]
