# Simple static frontend served by nginx. The page calls the API at a
# configurable base URL (default http://localhost:8123), entered in the UI.
#
# The server config is ours rather than the image's default, so the access and
# error logs are written to /var/log/nginx as real files as well as to
# stdout/stderr. Compose mounts that directory to ./data/logs/nginx on the host,
# which is what stops the access record dying with the container.
FROM nginx:alpine
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY frontend/ /usr/share/nginx/html/
EXPOSE 80
