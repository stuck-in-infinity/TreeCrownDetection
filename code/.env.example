# Example environment overrides for the Tree-Crown Species Pipeline backend.
# All settings can be overridden via env vars with the TCP_ prefix (see
# app/core/settings.py). Copy to .env and edit as needed.

# ── logging (side-channel; see docs/ERROR_LOGGING_PLAN.md §6) ──────────
# Central logging. log_dir defaults OUTSIDE storage_root/projects so app.log +
# errors.jsonl survive retention prune/delete. Text format is dev-readable;
# flip TCP_LOG_JSON=true in production for one JSON object per line.
TCP_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
TCP_LOG_DIR=/data/logs        # where app.log + errors.jsonl are written
TCP_LOG_JSON=false            # true => JSON lines (prod), false => text (dev)
TCP_LOG_MAX_BYTES=10000000    # RotatingFileHandler size cap per file (bytes)
TCP_LOG_BACKUP_COUNT=5        # rotated files kept per handler
