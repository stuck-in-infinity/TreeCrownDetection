# Local-only patch that restores the "Continue as guest" auth bypass for
# development. Not shipped: the pushed frontend requires Google sign-in.
# Re-apply with: git apply .guest-login.patch
# Remove again with: git apply -R .guest-login.patch
.guest-login.patch

# ── census / ground-truth research tooling (local-only, untracked) ─────
# One-off study of whether the BBMP tree census is usable as detectree2
# training ground truth. Not part of the pipeline: nothing under code/app
# imports any of it, and the scripts only reference each other. The files
# stay on the workstation; they are kept out of git so a stray `git add`
# cannot re-commit them. Kept alongside: run_retention.py (retention driver)
# and prep_lowres.py (strips alpha from 4-band RGBA orthos before tiling).
code/scripts/census_species_vote.py
code/scripts/check_cluster_species.py
code/scripts/compare_gt.py
code/scripts/consensus_gt.py
code/scripts/index_census.py
code/scripts/make_final_ppt.py
code/scripts/make_gt_report.py
code/scripts/make_lalbagh_pairs.py
code/scripts/make_species_check_fig.py
code/scripts/make_summary_md.py
code/scripts/make_tile_compare_fig.py
code/scripts/tune_detection.py
